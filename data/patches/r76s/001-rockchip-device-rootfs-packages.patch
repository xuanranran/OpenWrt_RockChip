Subject: [PATCH] rockchip: install optional packages per device

Keep shared root filesystems for uncustomized profiles. Install board-specific
multimedia packages and select the vendor Wi-Fi driver for NanoPi R76S.

--- a/include/image.mk
+++ b/include/image.mk
@@ -436,6 +436,7 @@
   DEVICE_ALT5_MODEL :=
   DEVICE_ALT5_VARIANT :=
   DEVICE_PACKAGES :=
+  DEVICE_ROOTFS_PACKAGES :=
   FEED_DEVICE_PACKAGES :=
   DEVICE_DESCRIPTION = Build firmware images for $$(DEVICE_TITLE)
 endef
@@ -589,11 +590,12 @@
       _PROFILE_SET :=
     endif
   endif
-  ifdef TARGET_PER_DEVICE_ROOTFS
+  ifneq ($$(strip $(TARGET_PER_DEVICE_ROOTFS) $$(DEVICE_ROOTFS_PACKAGES)),)
     _FEED_PACKAGES := $$(foreach pkg,$$(FEED_DEVICE_PACKAGES), \
       $$(if $$(CONFIG_PACKAGE_$$(pkg)),$$(pkg), \
         $$(if $$(_PROFILE_SET),$$(info WARNING: $(1): feed package '$$(pkg)' is not available, skipping it))))
-    $$(eval $$(call merge_packages,_PACKAGES,$$(DEVICE_PACKAGES) $$(_FEED_PACKAGES) $$(call DEVICE_EXTRA_PACKAGES,$(1))))
+    _PROFILE_PACKAGES = $$(if $(TARGET_PER_DEVICE_ROOTFS),$$(DEVICE_PACKAGES) $$(_FEED_PACKAGES) $$(call DEVICE_EXTRA_PACKAGES,$(1)))
+    $$(eval $$(call merge_packages,_PACKAGES,$$(_PROFILE_PACKAGES) $$(DEVICE_ROOTFS_PACKAGES)))
     ROOTFS_ID/$(1) := $$(if $$(_PROFILE_SET),$$(call mkfs_packages_id,$$(_PACKAGES)))
     PACKAGES_$$(ROOTFS_ID/$(1)) := $$(_PACKAGES)
   endif
@@ -752,10 +754,10 @@
 	$(KDIR)/root.$(1)$$(strip \
 		$$(if $$(FS_OPTIONS/$(1)),+fs=$$(call param_mangle,$$(FS_OPTIONS/$(1)))) \
 	)$$(strip \
-		$(if $(TARGET_PER_DEVICE_ROOTFS),+pkg=$$(ROOTFS_ID/$(3))) \
+		$$(if $$(ROOTFS_ID/$(3)),+pkg=$$(ROOTFS_ID/$(3))) \
 	)
   ifndef IB
-    $$(ROOTFS/$(1)/$(3)): $(if $(TARGET_PER_DEVICE_ROOTFS),target-dir-$$(ROOTFS_ID/$(3)))
+    $$(ROOTFS/$(1)/$(3)): $$(if $$(ROOTFS_ID/$(3)),target-dir-$$(ROOTFS_ID/$(3)))
   endif
   $(KDIR)/tmp/$(call DEVICE_IMG_NAME,$(1),$(2)): $$(KDIR_KERNEL_IMAGE) $$(ROOTFS/$(1)/$(3)) $(if $(CONFIG_TARGET_ROOTFS_INITRAMFS),$(if $(IB),,$(3)-initramfs-images))
 	@rm -f $$@
--- a/target/linux/rockchip/image/Makefile
+++ b/target/linux/rockchip/image/Makefile
@@ -19,7 +19,13 @@
 	$(CP) $(IMAGE_KERNEL) $@.boot/kernel.img
 endef
 
+R76S_PACKAGE_DB = $(call mkfs_target_dir,$(subst +,$(space),$(notdir $(IMAGE_ROOTFS))))/lib/apk/db/installed
+
 define Build/boot-nanopi-r76s
+	$(if $(CONFIG_USE_APK), \
+		grep -Fxq 'P:kmod-r8125' "$(R76S_PACKAGE_DB)" && \
+		grep -Fxq 'P:kmod-rtl8822cs' "$(R76S_PACKAGE_DB)" && \
+		! grep -Eq '^P:(kmod-r8169|kmod-rtw88-8822cs)$$' "$(R76S_PACKAGE_DB)")
 	$(call Build/boot-common)
 	$(CP) $(KDIR)/image-$(firstword $(DEVICE_DTS)).dtb $@.boot/rockchip.dtb
 endef
