Subject: [PATCH] rockchip: use a raw Image and vendor network drivers on R76S

Allow the R76S disk image to use a package-specific root filesystem while
the other profiles continue to use the existing shared root filesystem.
Boot the kernel with an external device tree, as in sbwml's R76S image.

Reference: https://github.com/sbwml/target_linux_rockchip/blob/24.10/image/nanopi-r76s.bootscript
---
diff --git a/include/image.mk b/include/image.mk
--- a/include/image.mk
+++ b/include/image.mk
@@ -436,6 +436,7 @@
   DEVICE_ALT5_MODEL :=
   DEVICE_ALT5_VARIANT :=
   DEVICE_PACKAGES :=
+  DEVICE_ROOTFS_PACKAGES :=
   FEED_DEVICE_PACKAGES :=
   DEVICE_DESCRIPTION = Build firmware images for $$(DEVICE_TITLE)
 endef
@@ -589,11 +590,12 @@
       _PROFILE_SET :=
     endif
   endif
-  ifdef TARGET_PER_DEVICE_ROOTFS
+  ifneq ($$(strip $(TARGET_PER_DEVICE_ROOTFS) $$(DEVICE_ROOTFS_PACKAGES)),)
     _FEED_PACKAGES := $$(foreach pkg,$$(FEED_DEVICE_PACKAGES), \
       $$(if $$(CONFIG_PACKAGE_$$(pkg)),$$(pkg), \
         $$(if $$(_PROFILE_SET),$$(info WARNING: $(1): feed package '$$(pkg)' is not available, skipping it))))
-    $$(eval $$(call merge_packages,_PACKAGES,$$(DEVICE_PACKAGES) $$(_FEED_PACKAGES) $$(call DEVICE_EXTRA_PACKAGES,$(1))))
+    _PROFILE_PACKAGES = $$(if $(TARGET_PER_DEVICE_ROOTFS),$$(DEVICE_PACKAGES) $$(_FEED_PACKAGES) $$(call DEVICE_EXTRA_PACKAGES,$(1)))
+    $$(eval $$(call merge_packages,_PACKAGES,$$(_PROFILE_PACKAGES) $$(DEVICE_ROOTFS_PACKAGES)))
     ROOTFS_ID/$(1) := $$(if $$(_PROFILE_SET),$$(call mkfs_packages_id,$$(_PACKAGES)))
     PACKAGES_$$(ROOTFS_ID/$(1)) := $$(_PACKAGES)
   endif
@@ -752,10 +754,10 @@
 	$(KDIR)/root.$(1)$$(strip \
 		$$(if $$(FS_OPTIONS/$(1)),+fs=$$(call param_mangle,$$(FS_OPTIONS/$(1)))) \
 	)$$(strip \
-		$(if $(TARGET_PER_DEVICE_ROOTFS),+pkg=$$(ROOTFS_ID/$(3))) \
+		$$(if $$(ROOTFS_ID/$(3)),+pkg=$$(ROOTFS_ID/$(3))) \
 	)
   ifndef IB
-    $$(ROOTFS/$(1)/$(3)): $(if $(TARGET_PER_DEVICE_ROOTFS),target-dir-$$(ROOTFS_ID/$(3)))
+    $$(ROOTFS/$(1)/$(3)): $$(if $$(ROOTFS_ID/$(3)),target-dir-$$(ROOTFS_ID/$(3)))
   endif
   $(KDIR)/tmp/$(call DEVICE_IMG_NAME,$(1),$(2)): $$(KDIR_KERNEL_IMAGE) $$(ROOTFS/$(1)/$(3)) $(if $(CONFIG_TARGET_ROOTFS_INITRAMFS),$(if $(IB),,$(3)-initramfs-images))
 	@rm -f $$@
diff --git a/target/linux/rockchip/image/Makefile b/target/linux/rockchip/image/Makefile
--- a/target/linux/rockchip/image/Makefile
+++ b/target/linux/rockchip/image/Makefile
@@ -17,6 +17,17 @@
 	mkdir -p $@.boot
 
 	$(CP) $(IMAGE_KERNEL) $@.boot/kernel.img
+endef
+
+R76S_PACKAGE_DB = $(call mkfs_target_dir,$(subst +,$(space),$(notdir $(IMAGE_ROOTFS))))/lib/apk/db/installed
+
+define Build/boot-nanopi-r76s
+	$(if $(CONFIG_USE_APK), \
+		grep -Fxq 'P:kmod-r8125' "$(R76S_PACKAGE_DB)" && \
+		grep -Fxq 'P:kmod-rtl8822cs' "$(R76S_PACKAGE_DB)" && \
+		! grep -Eq '^P:(kmod-r8169|kmod-rtw88-8822cs)$$' "$(R76S_PACKAGE_DB)")
+	$(call Build/boot-common)
+	$(CP) $(KDIR)/image-$(firstword $(DEVICE_DTS)).dtb $@.boot/rockchip.dtb
 endef
 
 define Build/boot-script
diff --git a/target/linux/rockchip/image/armv8.mk b/target/linux/rockchip/image/armv8.mk
--- a/target/linux/rockchip/image/armv8.mk
+++ b/target/linux/rockchip/image/armv8.mk
@@ -293,6 +293,12 @@
   $(Device/rk3576)
   DEVICE_VENDOR := FriendlyARM
   DEVICE_MODEL := NanoPi R76S
+  KERNEL_NAME := Image
+  KERNEL := kernel-bin
+  KERNEL_DEPENDS += $$(KDIR)/image-rk3576-nanopi-r76s.dtb
+  BOOT_SCRIPT := nanopi-r76s
+  IMAGE/sysupgrade.img.gz = boot-nanopi-r76s | boot-script $$(BOOT_SCRIPT) | $$(BOOT_FLOW) | gzip | append-metadata
+  DEVICE_ROOTFS_PACKAGES := kmod-r8125 kmod-rtl8822cs -kmod-r8169 -kmod-rtw88-8822cs
   DEVICE_PACKAGES += kmod-button-hotplug kmod-input-adc-keys kmod-r8125 kmod-rtw88-8822cs wpad-openssl
 endef
 TARGET_DEVICES += friendlyarm_nanopi-r76s
diff --git a/target/linux/rockchip/image/nanopi-r76s.bootscript b/target/linux/rockchip/image/nanopi-r76s.bootscript
new file mode 100644
--- /dev/null
+++ b/target/linux/rockchip/image/nanopi-r76s.bootscript
@@ -0,0 +1,8 @@
+if part uuid ${devtype} ${devnum}:2 uuid &&
+   load ${devtype} ${devnum}:1 ${fdt_addr_r} rockchip.dtb &&
+   load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img; then
+	setenv bootargs "coherent_pool=2M console=tty1 console=ttyS0,1500000 earlycon=uart8250,mmio32,0x2ad40000 root=PARTUUID=${uuid} rw rootwait"
+	booti ${kernel_addr_r} - ${fdt_addr_r}
+else
+	false
+fi
