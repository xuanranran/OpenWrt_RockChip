Subject: [PATCH] rockchip: package Bluetooth, media and NPU drivers by device

Enable Realtek H5 UART support and keep the RTL8822CS Bluetooth firmware
in the R76S image. Install media modules on matching board profiles.
Keep the USBDP PHY's AUX bridge in a separate package so its default
installation does not also install the Rockchip display and HDMI audio.

--- a/package/kernel/linux/modules/bluetooth.mk
+++ b/package/kernel/linux/modules/bluetooth.mk
@@ -38,13 +38,14 @@
 define KernelPackage/hci-uart
   SUBMENU:=$(BLUETOOTH_MENU)
   TITLE:=Bluetooth HCI UART support
-  DEPENDS:=+kmod-bluetooth +kmod-btbcm
+  DEPENDS:=+kmod-bluetooth +kmod-btbcm +kmod-btrtl
   KCONFIG:= \
 	CONFIG_BT_HCIUART \
 	CONFIG_BT_HCIUART_AML=n \
 	CONFIG_BT_HCIUART_BCM=y \
 	CONFIG_BT_HCIUART_INTEL=n \
 	CONFIG_BT_HCIUART_H4 \
+	CONFIG_BT_HCIUART_RTL=y \
 	CONFIG_BT_HCIUART_NOKIA=n
   FILES:= \
 	$(LINUX_DIR)/drivers/bluetooth/hci_uart.ko
@@ -61,7 +62,7 @@
 define KernelPackage/btusb
   SUBMENU:=$(BLUETOOTH_MENU)
   TITLE:=Bluetooth HCI USB support
-  DEPENDS:=@USB_SUPPORT +kmod-usb-core +kmod-bluetooth +kmod-btbcm +kmod-btmtk
+  DEPENDS:=@USB_SUPPORT +kmod-usb-core +kmod-bluetooth +kmod-btbcm +kmod-btmtk +kmod-btrtl
   KCONFIG:= \
 	CONFIG_BT_HCIBTUSB \
 	CONFIG_BT_HCIBTUSB_BCM=y \
@@ -69,8 +70,7 @@
 	CONFIG_BT_HCIBTUSB_RTL=y
   FILES:= \
 	$(LINUX_DIR)/drivers/bluetooth/btusb.ko \
-	$(LINUX_DIR)/drivers/bluetooth/btintel.ko \
-	$(LINUX_DIR)/drivers/bluetooth/btrtl.ko
+	$(LINUX_DIR)/drivers/bluetooth/btintel.ko
   AUTOLOAD:=$(call AutoProbe,btusb)
 endef
 
@@ -79,6 +79,18 @@
 endef
 
 $(eval $(call KernelPackage,btusb))
+
+
+define KernelPackage/btrtl
+  SUBMENU:=$(BLUETOOTH_MENU)
+  TITLE:=Realtek Bluetooth support
+  HIDDEN:=1
+  DEPENDS:=+kmod-bluetooth
+  KCONFIG:=CONFIG_BT_RTL
+  FILES:=$(LINUX_DIR)/drivers/bluetooth/btrtl.ko
+endef
+
+$(eval $(call KernelPackage,btrtl))
 
 
 define KernelPackage/btbcm
--- a/package/firmware/linux-firmware/realtek.mk
+++ b/package/firmware/linux-firmware/realtek.mk
@@ -124,6 +124,14 @@
 endef
 $(eval $(call BuildPackage,rtl8723de-firmware))
 
+Package/rtl8822cs-firmware = $(call Package/firmware-default,Realtek RTL8822CS Bluetooth firmware,,LICENCE.rtlwifi_firmware.txt)
+define Package/rtl8822cs-firmware/install
+	$(INSTALL_DIR) $(1)/lib/firmware/rtl_bt
+	$(INSTALL_DATA) $(PKG_BUILD_DIR)/rtl_bt/rtl8822cs_fw.bin $(1)/lib/firmware/rtl_bt
+	$(INSTALL_DATA) $(PKG_BUILD_DIR)/rtl_bt/rtl8822cs_config.bin $(1)/lib/firmware/rtl_bt
+endef
+$(eval $(call BuildPackage,rtl8822cs-firmware))
+
 Package/rtl8761a-firmware = $(call Package/firmware-default,RealTek RTL8761A firmware)
 define Package/rtl8761a-firmware/install
 	$(INSTALL_DIR) $(1)/lib/firmware/rtl_bt
